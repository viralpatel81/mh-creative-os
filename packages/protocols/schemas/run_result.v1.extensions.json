{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "run_result.v1.extensions.json",
  "title": "RunResultV1Extensions",
  "description": "Optional output blocks attached to the engine's run_result.v1 for the new ad/email/popup workflows. The base run_result.v1 schema in src/agentcy/protocols/schemas/ is not changed; consumers that need workflow-specific output check for the presence of these blocks.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "ad_output": {
      "type": "object",
      "additionalProperties": true,
      "required": ["images"],
      "properties": {
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["aspect", "path"],
            "properties": {
              "aspect": { "type": "string", "enum": ["1:1", "3:4", "9:16"] },
              "path": { "type": "string" },
              "template_id": { "type": "string" },
              "engine": { "type": "string", "enum": ["gemini", "openai"] },
              "qa": {
                "type": "object",
                "properties": {
                  "passed": { "type": "boolean" },
                  "concerns": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "email_output": {
      "type": "object",
      "additionalProperties": true,
      "required": ["images"],
      "properties": {
        "purpose": { "type": "string" },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["aspect", "path"],
            "properties": {
              "aspect": { "type": "string", "enum": ["2:3", "3:4", "9:16"] },
              "path": { "type": "string" },
              "engine": { "type": "string", "enum": ["gemini", "openai"] }
            }
          }
        }
      }
    },
    "popup_output": {
      "type": "object",
      "additionalProperties": true,
      "required": ["images"],
      "properties": {
        "purpose": { "type": "string" },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["aspect", "path"],
            "properties": {
              "aspect": { "type": "string", "enum": ["1:1", "4:5", "3:4"] },
              "path": { "type": "string" },
              "engine": { "type": "string", "enum": ["gemini", "openai"] }
            }
          }
        }
      }
    }
  }
}
